# Copy to env/production.env and fill in. The real file is gitignored.
#
# Select the ADP environment with `rpai env use <name>` after signing in.
#

ENV_NAME=production

CLUSTER_ID="<your-cluster-id>"
RESOURCE_GROUP_ID="<your-resource-group-uuid>"

DATAPLANE_API="https://api-<random>.<CLUSTER_ID>.byoc.prd.cloud.redpanda.com"
CONTROLPLANE_API=https://api.redpanda.com
AIGW_URL="https://aigw.<CLUSTER_ID>.clusters.rdpa.co"
ADP_API_URL="https://adp-api.<CLUSTER_ID>.clusters.rdpa.co"

# Must already exist on the cluster and allow the model below.
LLM_PROVIDER=anthropic-api-key
LLM_MODEL=claude-sonnet-4-6
# Optional: run the filtering agent on a smaller model. Leave blank to use the
# same one as the orchestrator, which is the recommendation — a smaller model
# picks noticeably worse shortlists.
SCOUT_MODEL=

# --- Postgres -------------------------------------------------------------
# Must be reachable over the public internet with TLS. The gateway refuses to
# dial private addresses, so a tunnel or VPC-internal database will not work.
PG_HOST="<your-postgres-host>"
PG_PORT=5432
PG_DATABASE=creatordemo

# --- The two demo identities ---------------------------------------------
# Both must EXIST in the ADP org with access to the agent. This is the
# slowest item to provision — do it first.
#
# The second address is who the restricted policy applies to. Individual people
# only — group targeting is not supported.
COORDINATOR_EMAIL="<coordinator@example.com>"
CONTRACTOR_EMAIL="<contractor@example.com>"

# --- Stable resource names — usually fine as-is --------------------------
MCP_CREATOR=creator-sql
MCP_FIT=fit-sql
MCP_CAMPAIGN=campaign-sql

PG_CREATOR_SECRET=PG_CREATOR_DSN
PG_FIT_SECRET=PG_FIT_DSN
PG_CAMPAIGN_SECRET=PG_CAMPAIGN_DSN

AGENT_NAME=creator-insights-orchestrator
AGENT_DISPLAY_NAME="Brand Insights Orchestrator"

BUDGET_NAME=creator-martech-demo
BUDGET_LIMIT_USD=25
BUDGET_WARN_USD=20
