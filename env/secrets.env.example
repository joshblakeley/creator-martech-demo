# Copy to env/secrets.env and fill in. The real file is gitignored and is
# shared by BOTH envs.
#
# The three role passwords are the only place these values live. 01-secret.sh
# assembles the DSNs from them plus PG_HOST/PG_PORT/PG_DATABASE and pushes
# each as a cluster secret, so a full connection string never lands in a
# committed file.

# Owner/superuser DSN. Used only by psql from your machine (schema, views,
# grants, seed data). Never pushed to the cluster, never handed to an MCP.
PG_ADMIN_DSN="postgres://postgres:<password>@<host>:5432/creatordemo?sslmode=require"

# One password per least-privilege role. These become the three cluster
# secrets the SQL MCP servers dial with. Generate them independently:
#   openssl rand -base64 24
PG_CREATOR_PW="<creator_sql password>"
PG_FIT_PW="<fit_sql password>"
PG_CAMPAIGN_PW="<campaign_sql password>"
