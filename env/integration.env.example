# Copy to env/integration.env and fill in. The real file is gitignored.
#
# Select the ADP environment with `rpai env use <name>` after signing in.
#

ENV_NAME=integration

CLUSTER_ID="<your-cluster-id>"
RESOURCE_GROUP_ID="<your-resource-group-uuid>"

DATAPLANE_API="https://api-<random>.<CLUSTER_ID>.byoc.ign.cloud.redpanda.com"
CONTROLPLANE_API=https://api.ign.cloud.redpanda.com
AIGW_URL="https://aigw.<CLUSTER_ID>.clusters.rdpa.co"
ADP_API_URL="https://adp-api.<CLUSTER_ID>.clusters.rdpa.co"

LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
SCOUT_MODEL=

# --- Postgres -------------------------------------------------------------
# Must be reachable over the public internet with TLS.
PG_HOST="<your-postgres-host>"
PG_PORT=5432
PG_DATABASE=creatordemo

# --- The two demo identities ---------------------------------------------
# Both must exist in the org with access to the agent. Individual users
# only: "Group:" principals fail CLOSED for the whole MCP server.
COORDINATOR_EMAIL="<coordinator@example.com>"
CONTRACTOR_EMAIL="<contractor@example.com>"

# --- Stable resource names — usually fine as-is --------------------------
MCP_CREATOR=creator-sql
MCP_FIT=fit-sql
MCP_CAMPAIGN=campaign-sql

PG_CREATOR_SECRET=PG_CREATOR_DSN
PG_FIT_SECRET=PG_FIT_DSN
PG_CAMPAIGN_SECRET=PG_CAMPAIGN_DSN

AGENT_NAME=creator-insights-orchestrator
AGENT_DISPLAY_NAME="Brand Insights Orchestrator"

BUDGET_NAME=creator-martech-demo
BUDGET_LIMIT_USD=25
BUDGET_WARN_USD=20
